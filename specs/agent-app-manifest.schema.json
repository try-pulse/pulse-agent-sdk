{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.trypulse.tech/.well-known/agent-app-manifest.schema.json",
  "title": "Pulse agent app manifest",
  "description": "Registers a third-party agent app with Pulse (schemaVersion 1.0.0). Normative for POST/PUT /api/v1/agent-apps and for the web app's manifest import. Source: pulse-api docs/openapi/schemas/agent-app-manifest.schema.json (PUL-929-2).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "developer", "oauth"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional. https://api.trypulse.tech/.well-known/agent-app-manifest.schema.json"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0",
      "description": "Manifest format version."
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "pattern": "\\S",
      "not": { "pattern": "[Pp][Uu][Ll][Ss][Ee]" },
      "description": "Display name, and the app's user name in each workspace it is installed in. Must not contain \"Pulse\" in any letter case. On a name clash in a workspace the user gets a numeric suffix (Scout becomes Scout 1)."
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Shown on the consent screen and in Installed agents."
    },
    "icon_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "maxLength": 2048,
      "description": "HTTPS URL of a square icon. Pulse proxies it; it is never hotlinked."
    },
    "developer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "pattern": "\\S",
          "description": "Who builds the app, shown next to it everywhere."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "maxLength": 2048,
          "description": "The developer's website."
        }
      }
    },
    "distribution": {
      "type": "string",
      "enum": ["private"],
      "default": "private",
      "description": "Only \"private\" in v1: the app installs only into the workspace it was registered in. \"public\" is refused."
    },
    "oauth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["redirect_uris", "scopes"],
      "properties": {
        "redirect_uris": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://[^\\s]+$",
            "maxLength": 2048
          },
          "description": "1 to 32 unique HTTPS callback URLs. The authorize request's redirect_uri must match one exactly."
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["read", "write", "issues:create", "comments:create", "app:assignable", "app:mentionable"]
          },
          "description": "Scopes the app may request with actor=app. write implies issues:create and comments:create. admin is never allowed."
        }
      }
    },
    "webhook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true,
          "description": "While false nothing is delivered and the app cannot be delegated to or mentioned."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^\\s]+$",
          "maxLength": 2048,
          "description": "Public HTTPS URL on port 443 or 8443 that receives signed app webhooks."
        },
        "resource_types": {
          "type": "array",
          "uniqueItems": true,
          "default": [],
          "items": { "type": "string", "enum": ["Issue", "Comment", "Project"] },
          "description": "Opt-in data events, filtered to the installation's teams. AgentSessionEvent, PermissionChange and OAuthApp are always delivered and must not be listed."
        }
      }
    }
  },
  "examples": [
    {
      "schemaVersion": "1.0.0",
      "name": "Scout",
      "developer": { "name": "Acme Labs" },
      "oauth": {
        "redirect_uris": ["https://scout.acme.example/oauth/callback"],
        "scopes": ["read", "write", "app:assignable"]
      },
      "webhook": { "url": "https://scout.acme.example/pulse/webhook" }
    },
    {
      "$schema": "https://api.trypulse.tech/.well-known/agent-app-manifest.schema.json",
      "schemaVersion": "1.0.0",
      "name": "Scout",
      "description": "Reads a delegated issue, plans the work and reports back in the session.",
      "icon_url": "https://scout.acme.example/icon.png",
      "developer": { "name": "Acme Labs", "url": "https://acme.example" },
      "distribution": "private",
      "oauth": {
        "redirect_uris": [
          "https://scout.acme.example/oauth/callback",
          "https://scout-staging.acme.example/oauth/callback"
        ],
        "scopes": ["read", "write", "app:assignable", "app:mentionable"]
      },
      "webhook": {
        "enabled": true,
        "url": "https://scout.acme.example/pulse/webhook",
        "resource_types": ["Issue", "Comment"]
      }
    }
  ]
}

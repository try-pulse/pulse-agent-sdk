{
  "name": "@try-pulse/agent-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Pulse agent apps: webhook verification, the Agent Session API, OAuth install and token refresh.",
  "license": "MIT",
  "homepage": "https://github.com/try-pulse/pulse-agent-sdk",
  "bugs": {
    "url": "https://github.com/try-pulse/pulse-agent-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/try-pulse/pulse-agent-sdk.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-reporter=spec 'dist/test/*.test.js'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public"
  }
}

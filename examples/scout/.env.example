# From POST /api/v1/agent-apps (shown once): client id, client secret, webhook secret
PULSE_CLIENT_ID=
PULSE_CLIENT_SECRET=
PULSE_WEBHOOK_SECRET=
# Public URL of this server; BASE_URL/oauth/callback must be in the manifest's redirect_uris
BASE_URL=https://scout.example.com
# Protects GET /oauth/authorize. Required.
INSTALL_SECRET=
# Optional
PORT=3000
PULSE_API_URL=https://api.trypulse.tech/api/v1
TOKEN_FILE=.pulse-tokens.json
# Slow each step down to try heartbeats, queued follow-ups and Stop on the pilot
SCOUT_STEP_DELAY_MS=0
SCOUT_HEARTBEAT_MS=300000

{
  "$schema": "https://api.trypulse.tech/.well-known/agent-app-manifest.schema.json",
  "schemaVersion": "1.0.0",
  "name": "Scout",
  "description": "Reads a delegated issue or a mention, plans, and reports back what it found. A deterministic sample agent from pulse-agent-sdk; no LLM.",
  "developer": { "name": "Pulse SDK samples", "url": "https://trypulse.tech/docs/developers/agents" },
  "distribution": "private",
  "oauth": {
    "redirect_uris": ["https://scout.example.com/oauth/callback"],
    "scopes": ["read", "write", "app:assignable", "app:mentionable"]
  },
  "webhook": {
    "enabled": true,
    "url": "https://scout.example.com/webhook",
    "resource_types": []
  }
}

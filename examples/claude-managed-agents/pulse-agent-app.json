{
  "$schema": "https://api.trypulse.tech/.well-known/agent-app-manifest.schema.json",
  "schemaVersion": "1.0.0",
  "name": "Claude Bridge",
  "description": "Forwards Pulse agent sessions to a Claude Managed Agent and streams the answer back. A port of Linear's claude-managed-agents-demo; example project, not for production use.",
  "developer": { "name": "Pulse SDK samples", "url": "https://trypulse.tech/docs/developers/agents" },
  "distribution": "private",
  "oauth": {
    "redirect_uris": ["https://claude-bridge.example.com/oauth/callback"],
    "scopes": ["read", "write", "app:assignable", "app:mentionable"]
  },
  "webhook": {
    "enabled": true,
    "url": "https://claude-bridge.example.com/webhook"
  }
}

# Anthropic API key for Claude Managed Agents
ANTHROPIC_API_KEY=

# Claude Managed Agent configuration (create the agent and environment once, outside this server)
CLAUDE_AGENT_ID=
CLAUDE_ENVIRONMENT_ID=

# Pulse agent app credentials (from POST /api/v1/agent-apps, shown once)
PULSE_CLIENT_ID=
PULSE_CLIENT_SECRET=
PULSE_WEBHOOK_SECRET=
# Protects GET /oauth/authorize
INSTALL_SECRET=

# Server configuration
PORT=3000
BASE_URL=
